[Unit]
Description=Nuestra Estantería (aplicación)
After=network-online.target
Wants=network-online.target

[Service]
User=estanteria
Group=estanteria
WorkingDirectory=/opt/estanteria/app
EnvironmentFile=/etc/estanteria/estanteria.env
ExecStart=/opt/estanteria/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --timeout 300 --access-logfile - estanteria:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
